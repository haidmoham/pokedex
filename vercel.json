{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "POKEDEX_MODEL_RELEASE=2026-10-01-998 npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/review",
      "destination": "/review.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
